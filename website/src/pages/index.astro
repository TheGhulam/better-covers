---
/**
 * Home — fixed corner labels, hero with one-shot Conway's Life,
 * vertical scroll of centered covers, bottom project strip.
 *
 * Each cover is itself a button: click it to open the studio
 * <dialog>, edit the seed, re-render, and download the PNG.
 * No separate /studio page — the studio lives inline as a modal.
 */
import Site from "../layouts/Site.astro";
import { COVERS } from "../covers/catalog";
---

<Site>
  <!-- ---------- fixed corner labels ---------- -->
  <header class="corner tl">
    <a href="/" class="wordmark">better<span class="em">—</span>covers</a>
  </header>

  <aside class="corner tr">
    <span class="position">
      <span class="position-current" id="position-current">00</span>
      <span class="position-sep">/</span>
      <span class="position-total" id="position-total"
        >{String(COVERS.length).padStart(2, "0")}</span
      >
    </span>
  </aside>

  <aside class="corner bl">
    an experimental gallery to generate<br />
    and explore deterministic cover art.
  </aside>

  <aside class="corner br">
    <span style="color: var(--fg-dim)">© 2026</span>
  </aside>

  <!-- ---------- hero: one-shot Life reveal ---------- -->
  <section class="hero">
    <div class="hero-stage">
      <canvas class="hero-canvas" id="hero" width="1200" height="630"></canvas>
      <div class="hero-caption" id="hero-cap">
        <span class="dot"></span>computing — generation <span id="hero-gen"
          >0</span
        >
      </div>
    </div>
  </section>

  <!-- ---------- gallery: one cover per viewport ---------- -->
  <main class="gallery" id="gallery">
    {
      COVERS.map((c, idx) => (
        <button
          class="cover-slot loading"
          type="button"
          data-id={c.id}
          data-idx={idx}
          aria-label={`Open ${c.title} in studio`}
        >
          <canvas
            class="cover-canvas"
            width="1200"
            height="630"
            aria-hidden="true"
          />
          <div class="cover-meta">
            <span class="n">{c.num}</span>
            <span class="t">{c.title}</span>
          </div>
        </button>
      ))
    }
  </main>

  <!-- ---------- studio dialog (native <dialog>) ---------- -->
  <dialog class="studio" id="studio" aria-labelledby="panel-title">
    <div class="studio-inner">
      <button
        class="studio-close"
        id="studio-close"
        type="button"
        aria-label="Close studio">×</button
      >

      <section class="studio-stage">
        <div class="stage-frame" id="stage-frame">
          <div class="stage-progress" id="stage-progress"></div>
        </div>
        <div class="stage-meta">
          <span>
            <span class="n" id="panel-num">00</span>
          </span>
          <span class="right">
            seed · <span class="v" id="panel-seed-meta">—</span>
          </span>
        </div>
      </section>

      <aside class="studio-panel">
        <header class="panel-head">
          <h2 class="panel-title" id="panel-title">—</h2>
        </header>

        <!-- Info drawer: collapsed by default. Clicking the trigger
             reveals the subtitle and body blurb. Title stays visible
             above since it's the anchor for the rest of the panel. -->
        <div class="info" id="info">
          <button
            class="info-trigger"
            id="info-trigger"
            type="button"
            aria-expanded="false"
            aria-controls="info-drawer"
          >
            <svg
              class="info-icon"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <span class="info-label">About this design</span>
            <span class="info-chevron" aria-hidden="true">▾</span>
          </button>
          <div
            class="info-drawer"
            id="info-drawer"
            role="region"
            aria-label="Plate details"
          >
            <div class="info-drawer-inner">
              <p class="panel-subtitle" id="panel-subtitle">—</p>
              <p class="panel-body" id="panel-body">—</p>
            </div>
          </div>
        </div>

        <div class="format-row">
          <div class="format-label-row">
            <label class="seed-label" for="format-select">Format</label>
          </div>
          <select class="format-select" id="format-select">
            <option value="1200x630">OpenGraph (1200×630)</option>
            <option value="1080x1080">Podcast / Sq (1080×1080)</option>
            <option value="1280x720">YouTube (1280×720)</option>
            <option value="1920x1080">Desktop / 16:9 (1920×1080)</option>
            <option value="1500x600">Notion Cover (1500×600)</option>
            <option value="1080x2400">Mobile (1080×2400)</option>
          </select>
        </div>

        <div class="seed-row">
          <div class="seed-label-row">
            <label class="seed-label" for="seed-input">Seed</label>
            <button
              class="seed-shuffle"
              id="btn-shuffle"
              type="button"
              aria-label="Randomize seed"
            >
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M16 3h5v5"></path>
                <path d="M4 20 21 3"></path>
                <path d="M21 16v5h-5"></path>
                <path d="M15 15l6 6"></path>
                <path d="M4 4l5 5"></path>
              </svg>
              <span>Shuffle</span>
            </button>
          </div>
          <input
            class="seed-input"
            id="seed-input"
            type="text"
            autocomplete="off"
            spellcheck="false"
          />
        </div>

        <div class="btn-row">
          <button class="btn btn-primary" id="btn-render" type="button">
            <span class="default-label">Render</span>
          </button>
          <button class="btn" id="btn-download" type="button">
            <span class="default-label">Download</span>
            <span class="saved-label">Saved ✓</span>
          </button>
        </div>

        <p class="panel-refs" id="panel-refs">—</p>
      </aside>
    </div>
  </dialog>

  <script>
    import { initGallery } from "../scripts/gallery.ts";
    initGallery();
  </script>
</Site>
