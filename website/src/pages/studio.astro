---
/**
 * Studio — pick a renderer, type a seed, paint the 1200×630 cover,
 * download the PNG. Sticky stage on the left, controls on the right.
 *
 * Deep-link: /studio?cover=<id>&seed=<value>
 */
import Site from '../layouts/Site.astro';
import { COVERS } from '../covers/catalog';
---

<Site title="Studio — better-covers" description="Generate covers with custom seeds.">
  <!-- ---------- fixed corners ---------- -->
  <header class="corner tl">
    <a href="/" class="wordmark">better<span class="em">—</span>covers</a>
  </header>

  <aside class="corner tr">
    <span class="label">Section</span>
    <span>Studio · 01</span>
  </aside>

  <aside class="corner bl bare">
    <a href="/" class="back">back to gallery</a>
  </aside>

  <aside class="corner br bare">
    <span style="color: var(--fg-dim)">© 2026</span>
  </aside>

  <main class="studio">
    <!-- ---------- stage (sticky) ---------- -->
    <section class="stage">
      <div class="stage-frame">
        <canvas class="stage-canvas" id="canvas" width="1200" height="630"></canvas>
        <div class="spinner" id="spinner">
          <div class="spinner-mark"></div>
          <div class="spinner-text">painting · <span id="spinner-est">~1s</span></div>
        </div>
      </div>
      <div class="stage-meta">
        <span>
          <span class="n" id="m-num">{COVERS[0].num}</span>
          <span class="t" id="m-title">{COVERS[0].title}</span>
        </span>
        <span class="right">seed · <span class="v" id="m-seed">{COVERS[0].defaultSeed}</span></span>
      </div>
    </section>

    <!-- ---------- panel ---------- -->
    <aside class="panel">
      <div class="field">
        <label class="field-label" for="seed">Seed</label>
        <input
          id="seed"
          type="text"
          value={COVERS[0].defaultSeed}
          autocomplete="off"
          spellcheck="false"
        />
      </div>

      <div class="field">
        <span class="field-label">Renderer</span>
        <div class="dropdown" id="dd">
          <button class="dropdown-toggle" id="dd-btn" type="button" aria-haspopup="listbox" aria-expanded="false">
            <span>
              <span class="num" id="dd-num">{COVERS[0].num}</span>
              <span id="dd-title">{COVERS[0].title}</span>
            </span>
            <span class="arrow" aria-hidden="true">▾</span>
          </button>
          <div class="dropdown-menu" id="dd-menu" role="listbox">
            {COVERS.map((c) => (
              <div class="dropdown-item" data-id={c.id} role="option" tabindex="0">
                <span class="num">{c.num}</span>{c.title}
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="row">
        <button class="btn" id="randomize" type="button">Randomize</button>
        <button class="btn btn-primary" id="render" type="button">Render</button>
      </div>

      <button class="btn" id="download" type="button">Download 1200 × 630</button>

      <div>
        <p class="blurb" id="blurb">{COVERS[0].body}</p>
        <p class="blurb-meta" id="blurb-meta">{COVERS[0].refs}</p>
      </div>
    </aside>
  </main>

  <script>
    import { initStudio } from '../scripts/studio.ts';
    initStudio();
  </script>
</Site>
